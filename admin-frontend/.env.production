# === Django Core ===
DJANGO_SECRET_KEY=your-very-secure-random-secret-key
DEBUG=true

# === Allowed Hosts (separate by space or comma) ===
DJANGO_ALLOWED_HOSTS=['*'] #lock down in production

# MySQL Database settings
MYSQL_DB=dblipad
MYSQL_USER=lipadadmin
MYSQL_PASSWORD=LipadAdmin
MYSQL_HOST=localhost
MYSQL_PORT=3306

# === Media / Static Files ===
MEDIA_URL=/media/
MEDIA_ROOT=media

# === Security Flags ===
# Make sure you are serving over HTTPS in production
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

#   - Use SameSite=None with Secure
SESSION_COOKIE_SAMESITE=None


#SECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https') // pag naka-nginx na